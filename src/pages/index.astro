---
import { getCollection } from "astro:content";
import CameraFlash from "@/components/CameraFlash.astro";
import Hero from "@/components/Hero.astro";
import WorkCard from "@/components/WorkCard.astro";
import Base from "@/layouts/Base.astro";

const work = (await getCollection("work", ({ data }) => !data.draft))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <CameraFlash />
  <Hero />
  <section
    id="selected-work"
    class="site-container selected-work"
    aria-labelledby="selected-work-title"
  >
    <div class="section-heading">
      <h2 id="selected-work-title" class="h1">Case studies</h2>
    </div>
    <div class="work-grid">
      {
        work.map((entry, index) => (
          <WorkCard
            entry={entry}
            loading="eager"
            priority={index === 0}
            sizes="(min-width: 48rem) 31vw, calc(100vw - 2rem)"
          />
        ))
      }
    </div>
  </section>
</Base>

<style>
  .selected-work {
    display: grid;
    gap: 2rem;
    padding-block: var(--gap-section);
  }

  .section-heading {
    display: grid;
    gap: 0.75rem;
    max-width: 48rem;
  }

  .section-heading h2 {
    margin: 0;
  }

  .work-grid {
    display: grid;
    gap: var(--gutter-grid);
  }

  @media (min-width: 48rem) {
    .work-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
