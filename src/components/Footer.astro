---
import { site } from "@/lib/site";
---

<footer class="site-footer">
  <div class="site-container footer-inner">
    <div>
      <p class="footer-copyright">&copy; 2026 Matthew Ozoroski. All rights reserved</p>
    </div>
    <nav aria-label="Footer links">
      <a href={`mailto:${site.email}`}>Email</a>
      <a href={site.socials.linkedin}>LinkedIn</a>
      <a href="/work/">Work</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-block-start: 1px solid var(--color-surface-muted);
    margin-block-start: var(--gap-section);
    padding-block: 2rem;
  }

  .footer-inner {
    display: grid;
    gap: 1.5rem;
  }

  .footer-copyright {
    color: var(--color-muted);
    margin: 0;
  }

  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .site-footer nav a {
    align-items: center;
    display: inline-flex;
    min-height: 44px;
  }

  @media (min-width: 48rem) {
    .footer-inner {
      align-items: start;
      grid-template-columns: 1fr auto;
    }
  }
</style>
