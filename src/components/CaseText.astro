---
interface Props {
  align?: "center" | "right";
  heading?: string;
}

const { align = "center", heading } = Astro.props;
---

<section class:list={["case-text", `case-text-${align}`]}>
  {heading && <h2 class="case-text-heading">{heading}</h2>}
  <div class="case-text-content">
    <slot />
  </div>
</section>

<style>
  .case-text {
    display: grid;
    gap: var(--case-heading-copy-gap, var(--spacing-250));
    max-width: var(--measure-prose);
    min-width: 0;
  }

  .case-text.case-text :global(*) {
    margin-block: 0;
  }

  .case-text-heading {
    border-block-start: 0;
    padding-block-start: 0;
  }

  .case-text-center {
    justify-self: center;
    text-align: center;
    width: min(100%, calc(var(--spacing-1600) * 5.5));
  }

  .case-text-right {
    margin-block-start: 0;
  }

  @media (min-width: 64rem) {
    .case-text-center {
      grid-column: 1 / -1;
    }

    .case-text-right {
      grid-column: 2;
      margin-block-start: 0;
      max-width: calc(var(--spacing-1600) * 3.25);
    }
  }
</style>
