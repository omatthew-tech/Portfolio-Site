---
interface Props {
  src: string;
  poster?: string;
  type?: string;
  label?: string;
  width?: number;
  height?: number;
  autoplay?: boolean;
  loop?: boolean;
  preload?: "none" | "metadata" | "auto";
}

const {
  src,
  poster,
  type = "video/webm",
  label,
  width = 1280,
  height = 720,
  autoplay = true,
  loop = true,
  preload = "metadata",
} = Astro.props;

const isPortrait = height > width;
---

<figure class:list={["case-video", isPortrait && "case-video-portrait"]}>
  <div class:list={["case-video-frame", isPortrait && "iphone-frame"]}>
    {
      isPortrait && (
        <>
          <span class="iphone-button iphone-button-action" aria-hidden="true" />
          <span class="iphone-button iphone-button-volume-up" aria-hidden="true" />
          <span class="iphone-button iphone-button-volume-down" aria-hidden="true" />
          <span class="iphone-button iphone-button-power" aria-hidden="true" />
        </>
      )
    }
    <video
      data-case-video
      data-src={src}
      data-type={type}
      class:list={["case-video-media", isPortrait && "case-video-media-portrait"]}
      style={`--case-video-aspect: ${width} / ${height}`}
      autoplay={autoplay}
      muted={autoplay}
      loop={loop}
      playsinline
      preload={preload}
      poster={poster}
      width={width}
      height={height}
      aria-label={label || undefined}
      aria-hidden={label ? undefined : "true"}
    >
    </video>
  </div>
</figure>

<script>
  const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
  const videos = Array.from(document.querySelectorAll("[data-case-video]"));

  const loadVideo = (video: HTMLVideoElement) => {
    if (video.dataset.loaded === "true" || !video.dataset.src) return;

    const source = document.createElement("source");
    source.src = video.dataset.src;
    source.type = video.dataset.type ?? "video/webm";
    video.append(source);
    video.dataset.loaded = "true";
    video.load();
  };

  const playVideo = (video: HTMLVideoElement) => {
    if (motionQuery.matches) {
      video.pause();
      return;
    }

    loadVideo(video);
    video.play().catch(() => {});
  };

  const observer =
    "IntersectionObserver" in window
      ? new IntersectionObserver(
          (entries, activeObserver) => {
            entries.forEach((entry) => {
              if (!(entry.target instanceof HTMLVideoElement)) return;
              if (!entry.isIntersecting) return;

              playVideo(entry.target);
              activeObserver.unobserve(entry.target);
            });
          },
          { rootMargin: "200px" },
        )
      : undefined;

  const syncMotionPreference = () => {
    videos.forEach((video) => {
      if (!(video instanceof HTMLVideoElement)) return;

      if (motionQuery.matches) {
        video.pause();
        return;
      }

      if (observer && video.dataset.loaded !== "true") {
        observer.observe(video);
        return;
      }

      playVideo(video);
    });
  };

  syncMotionPreference();
  motionQuery.addEventListener("change", syncMotionPreference);
</script>

<style>
  .case-video {
    background: var(--color-neutral);
    border: 1px solid var(--color-surface-muted);
    border-radius: var(--radius-lg);
    margin: 0;
    overflow: hidden;
    padding: var(--spacing-100);
  }

  .case-video-frame {
    width: 100%;
  }

  .case-video-media {
    aspect-ratio: var(--case-video-aspect, 16 / 9);
    background: var(--color-surface);
    border-radius: var(--radius-md);
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  .case-video-portrait {
    display: grid;
    place-items: center;
  }

  .iphone-frame {
    background: var(--color-primary);
    border: var(--spacing-025) solid var(--color-muted);
    border-radius: calc(var(--radius-xl) + var(--spacing-250));
    box-shadow: var(--shadow-elev-2);
    box-sizing: border-box;
    max-width: 100%;
    padding: var(--spacing-075);
    position: relative;
    width: fit-content;
  }

  .iphone-frame .case-video-media {
    border-radius: calc(var(--radius-xl) + var(--spacing-100));
    position: relative;
    z-index: 1;
  }

  .case-video-media-portrait {
    margin-inline: auto;
    max-height: min(80vh, calc(var(--spacing-1600) * 7));
    max-width: 100%;
    width: auto;
  }

  .iphone-button {
    background: var(--color-muted);
    border-radius: var(--radius-pill);
    position: absolute;
    width: var(--spacing-050);
  }

  .iphone-button-action,
  .iphone-button-volume-up,
  .iphone-button-volume-down {
    inset-inline-start: calc(var(--spacing-050) * -1);
  }

  .iphone-button-action {
    height: var(--spacing-150);
    inset-block-start: 17%;
  }

  .iphone-button-volume-up {
    height: var(--spacing-300);
    inset-block-start: 24%;
  }

  .iphone-button-volume-down {
    height: var(--spacing-300);
    inset-block-start: 31%;
  }

  .iphone-button-power {
    height: var(--spacing-400);
    inset-block-start: 27%;
    inset-inline-end: calc(var(--spacing-050) * -1);
  }
</style>
