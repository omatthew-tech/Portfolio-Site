---
import { site } from "@/lib/site";
---

<section class="contact-cta site-container" aria-labelledby="contact-cta-title">
  <div>
    <h2 id="contact-cta-title" class="display-md">Have a UX problem worth untangling?</h2>
  </div>
  <a class="button button-primary" href={`mailto:${site.email}`}>Email Matt</a>
</section>

<style>
  .contact-cta {
    align-items: start;
    border-block: 1px solid var(--color-surface-muted);
    display: grid;
    gap: 1.5rem;
    padding-block: var(--gap-section);
  }

  .contact-cta h2 {
    margin: 0;
    max-width: 12ch;
  }

  @media (min-width: 48rem) {
    .contact-cta {
      align-items: center;
      grid-template-columns: 1fr auto;
    }
  }
</style>
