---
interface Props {
  attribution?: string;
}

const { attribution } = Astro.props;
---

<figure class="quote">
  <blockquote>
    <slot />
  </blockquote>
  {attribution && <figcaption>{attribution}</figcaption>}
</figure>

<style>
  .quote {
    border-block: 1px solid var(--color-surface-muted);
    margin: 0;
    padding-block: 2rem;
  }

  blockquote {
    border: 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3rem);
    line-height: 1.1;
    margin: 0;
    padding: 0;
  }

  figcaption {
    color: var(--color-muted);
    font-size: 0.875rem;
    margin-block-start: 1rem;
  }
</style>
