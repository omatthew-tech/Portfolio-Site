---
import Figure from "@/components/Figure.astro";

interface Annotation {
  text: string;
  left: number;
  top: number;
  size?: number;
  width?: number;
  height?: number;
  lineY: number;
  copyY?: number;
  side?: "left" | "right";
}

interface Props {
  src: string;
  alt: string;
  annotations: Annotation[];
  copySide?: "left" | "right";
  width?: number;
  height?: number;
}

const {
  src,
  alt,
  annotations,
  copySide = "left",
  width = 1320,
  height = 2868,
} = Astro.props;

const annotationSide = (annotation: Annotation) =>
  annotation.side ?? copySide;

const annotatedItems = annotations.map((annotation, index) => ({
  annotation,
  index,
}));
const leftAnnotations = annotatedItems.filter(
  ({ annotation }) => annotationSide(annotation) === "left",
);
const rightAnnotations = annotatedItems.filter(
  ({ annotation }) => annotationSide(annotation) === "right",
);
const isSplit = leftAnnotations.length > 0 && rightAnnotations.length > 0;

const annotationStyle = (annotation: Annotation) => {
  const targetWidth = annotation.width ?? annotation.size ?? 20;
  const targetHeight =
    annotation.height ?? targetWidth * (width / height);
  const copyY = annotation.copyY ?? annotation.lineY;

  return [
    `--target-left: ${annotation.left}%`,
    `--target-top: ${annotation.top}%`,
    `--target-width: ${targetWidth}%`,
    `--target-height: ${targetHeight}%`,
    `--target-right: ${100 - annotation.left - targetWidth}%`,
    `--line-y: ${annotation.lineY}%`,
    `--copy-y: ${copyY}%`,
    `--elbow-top: ${Math.min(copyY, annotation.lineY)}%`,
    `--elbow-height: ${Math.abs(copyY - annotation.lineY)}%`,
  ].join("; ");
};
---

<section
  class:list={[
    "figure",
    "annotated-phone",
    !isSplit && copySide === "right" && "annotated-phone-copy-right",
    isSplit && "annotated-phone-split",
  ]}
  aria-label="Annotated LittlePickle interface"
>
  {
    leftAnnotations.length > 0 && (
      <ol
        class="annotation-copy annotation-copy-left"
        aria-label="Interface design decisions"
      >
        {leftAnnotations.map(({ annotation, index }) => (
          <li
            class="annotation-copy-item"
            style={`--copy-y: ${annotation.copyY ?? annotation.lineY}%; --mobile-order: ${index + 2}`}
          >
            <p>{annotation.text}</p>
          </li>
        ))}
      </ol>
    )
  }

  {
    rightAnnotations.length > 0 && (
      <ol
        class="annotation-copy annotation-copy-right"
        aria-label="Interface design decisions"
      >
        {rightAnnotations.map(({ annotation, index }) => (
          <li
            class="annotation-copy-item"
            style={`--copy-y: ${annotation.copyY ?? annotation.lineY}%; --mobile-order: ${index + 2}`}
          >
            <p>{annotation.text}</p>
          </li>
        ))}
      </ol>
    )
  }

  <div class="phone-frame">
    <span class="phone-button phone-button-action" aria-hidden="true"></span>
    <span class="phone-button phone-button-volume-up" aria-hidden="true"></span>
    <span class="phone-button phone-button-volume-down" aria-hidden="true"></span>
    <span class="phone-button phone-button-power" aria-hidden="true"></span>

    <div class="phone-screen">
      <Figure
        src={src}
        alt={alt}
        width={width}
        height={height}
        variant="screenshot"
        card={false}
        sizes="(min-width: 64rem) 24rem, min(24rem, calc(100vw - 4rem))"
      />

      {
        annotations.map((annotation) => (
          <span
            class="annotation-target"
            style={annotationStyle(annotation)}
            aria-hidden="true"
          />
        ))
      }
    </div>

    {
      annotations.map((annotation) => (
        <>
          <span
            class:list={[
              "annotation-line",
              annotationSide(annotation) === "right" &&
                "annotation-line-right",
            ]}
            style={annotationStyle(annotation)}
            aria-hidden="true"
          />
          <span
            class:list={[
              "annotation-elbow",
              annotationSide(annotation) === "right" &&
                "annotation-elbow-right",
            ]}
            style={annotationStyle(annotation)}
            aria-hidden="true"
          />
        </>
      ))
    }
  </div>
</section>

<style>
  .annotated-phone {
    align-items: stretch;
    display: grid;
    gap: var(--gap-section);
    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, calc(var(--spacing-1600) * 3));
    margin: 0;
    position: relative;
    width: 100%;
  }

  .annotated-phone-copy-right {
    grid-template-columns:
      minmax(0, calc(var(--spacing-1600) * 3))
      minmax(0, 1fr);
  }

  .annotated-phone-split {
    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, calc(var(--spacing-1600) * 3))
      minmax(0, 1fr);
  }

  .annotation-copy {
    grid-row: 1;
    list-style: none;
    margin: 0;
    min-height: 100%;
    padding: 0;
    position: relative;
    z-index: 3;
  }

  .annotation-copy-left {
    grid-column: 1;
  }

  .annotation-copy-right {
    grid-column: 2;
  }

  .annotated-phone-split .annotation-copy-right {
    grid-column: 3;
  }

  .annotation-copy-item {
    inset-block-start: var(--copy-y);
    inset-inline: 0;
    margin: 0;
    position: absolute;
    transform: translateY(-50%);
  }

  .annotation-copy-left .annotation-copy-item {
    padding-inline-end: var(--spacing-300);
  }

  .annotation-copy-right .annotation-copy-item {
    padding-inline: var(--spacing-300) 0;
  }

  .annotation-copy-item p {
    margin: 0;
    max-width: var(--measure-prose);
  }

  .annotation-copy-left .annotation-copy-item::after,
  .annotation-copy-right .annotation-copy-item::before {
    border-block-start: var(--spacing-025) solid var(--color-accent);
    content: "";
    inset-block-start: 50%;
    position: absolute;
    width: calc(var(--gap-section) + var(--spacing-100));
    z-index: 3;
  }

  .annotation-copy-left .annotation-copy-item::after {
    inset-inline-start: 100%;
  }

  .annotation-copy-right .annotation-copy-item::before {
    inset-inline-end: 100%;
  }

  .phone-frame {
    align-self: start;
    background: var(--color-primary);
    border: var(--spacing-025) solid var(--color-muted);
    border-radius: calc(var(--radius-xl) + var(--spacing-250));
    box-shadow: var(--shadow-elev-2);
    box-sizing: border-box;
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
    max-width: 100%;
    padding: var(--spacing-075);
    position: relative;
    width: calc(var(--spacing-1600) * 3);
  }

  .annotated-phone-copy-right .phone-frame {
    grid-column: 1;
    justify-self: start;
  }

  .annotated-phone-split .phone-frame {
    grid-column: 2;
    justify-self: center;
  }

  .phone-screen {
    border-radius: calc(var(--radius-xl) + var(--spacing-100));
    overflow: hidden;
    position: relative;
  }

  .phone-screen :global(.figure) {
    width: 100%;
  }

  .phone-screen :global(.figure img) {
    border-radius: 0;
    display: block;
    height: auto;
    max-height: none;
    width: 100%;
  }

  .phone-button {
    background: var(--color-muted);
    border-radius: var(--radius-pill);
    position: absolute;
    width: var(--spacing-050);
  }

  .phone-button-action,
  .phone-button-volume-up,
  .phone-button-volume-down {
    inset-inline-start: calc(var(--spacing-050) * -1);
  }

  .phone-button-action {
    height: var(--spacing-150);
    inset-block-start: 17%;
  }

  .phone-button-volume-up {
    height: var(--spacing-300);
    inset-block-start: 24%;
  }

  .phone-button-volume-down {
    height: var(--spacing-300);
    inset-block-start: 31%;
  }

  .phone-button-power {
    height: var(--spacing-400);
    inset-block-start: 27%;
    inset-inline-end: calc(var(--spacing-050) * -1);
  }

  .annotation-target {
    border: var(--spacing-025) solid var(--color-accent);
    border-radius: var(--radius-pill);
    box-shadow: 0 0 0 var(--spacing-050)
      color-mix(in srgb, var(--color-accent) 20%, transparent);
    height: var(--target-height);
    inset-block-start: var(--target-top);
    inset-inline-start: var(--target-left);
    position: absolute;
    width: var(--target-width);
    z-index: 2;
  }

  .annotation-line {
    background: var(--color-accent);
    height: var(--spacing-025);
    inset-block-start: var(--line-y);
    inset-inline-start: calc(var(--spacing-025) * -1);
    position: absolute;
    width: calc(var(--target-left) + var(--spacing-100));
    z-index: 1;
  }

  .annotation-line-right {
    inset-inline-end: calc(var(--spacing-025) * -1);
    inset-inline-start: auto;
    width: calc(var(--target-right) + var(--spacing-100));
  }

  .annotation-elbow {
    background: var(--color-accent);
    height: var(--elbow-height);
    inset-block-start: var(--elbow-top);
    inset-inline-start: calc(var(--spacing-025) * -1);
    position: absolute;
    width: var(--spacing-025);
    z-index: 1;
  }

  .annotation-elbow-right {
    inset-inline-end: calc(var(--spacing-025) * -1);
    inset-inline-start: auto;
  }

  .annotated-phone + .annotated-phone {
    margin-block-start: var(--gap-section);
  }

  @media (max-width: 63.99rem) {
    .annotated-phone,
    .annotated-phone-copy-right,
    .annotated-phone-split {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-300);
    }

    .phone-frame,
    .annotated-phone-copy-right .phone-frame,
    .annotated-phone-split .phone-frame {
      align-self: center;
      max-width: calc(100% - var(--spacing-200));
      order: 1;
      width: calc(var(--spacing-1600) * 2.5);
    }

    .annotation-copy,
    .annotated-phone-copy-right .annotation-copy,
    .annotated-phone-split .annotation-copy {
      display: contents;
    }

    .annotation-copy-item,
    .annotated-phone-copy-right .annotation-copy-item,
    .annotated-phone-split .annotation-copy-item {
      inset: auto;
      order: var(--mobile-order);
      padding-inline: var(--spacing-300) 0;
      position: relative;
      transform: none;
    }

    .annotation-copy-left .annotation-copy-item::after,
    .annotation-copy-right .annotation-copy-item::after {
      border-block-start: var(--spacing-025) solid var(--color-accent);
      content: "";
      inset-block-start: 0.7em;
      inset-inline: 0 auto;
      position: absolute;
      width: var(--spacing-200);
    }

    .annotation-copy-right .annotation-copy-item::before {
      content: none;
    }
  }
</style>
