---
import Figure from "@/components/Figure.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"work">;
}

const { entry } = Astro.props;
const { title, summary, cover } = entry.data;
---

<article class="work-card">
  <a class="cover-link" href={`/work/${entry.slug}/`} aria-label={`View case study: ${title}`}>
    <Figure id={cover.id} alt={cover.alt} width={1600} height={1000} />
  </a>
  <div class="work-card-copy">
    <h3 class="h3"><a href={`/work/${entry.slug}/`}>{title}</a></h3>
    <p>{summary}</p>
  </div>
</article>

<style>
  .work-card {
    border: 1px solid var(--color-surface-muted);
    border-radius: var(--radius-lg);
    display: grid;
    gap: 1rem;
    padding: var(--pad-card);
    transition:
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .work-card:hover {
    box-shadow: var(--shadow-elev-1);
    transform: translateY(-2px);
  }

  .cover-link {
    color: inherit;
    text-decoration: none;
  }

  .work-card-copy {
    display: grid;
    gap: 0.6rem;
  }

  .work-card h3,
  .work-card p {
    margin: 0;
  }

  .work-card h3 a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .work-card h3 a:hover {
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card,
    .work-card:hover {
      box-shadow: none;
      transform: none;
    }
  }
</style>
