---
const pathname = Astro.url.pathname;

type NavLink = {
  href: string;
  label: string;
  rel?: string;
  show: boolean;
  target?: string;
};

const links: NavLink[] = [
  { href: "/work/", label: "Work", show: true },
  { href: "/about/", label: "About", show: true },
  {
    href: "https://drive.google.com/file/d/1vGwXCmokh5h-U6-WVqYGtb8bYkqlzeot/view?usp=sharing",
    label: "Resume",
    rel: "noreferrer",
    show: true,
    target: "_blank",
  },
].filter((link) => link.show);

const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="site-nav">
  <div class="site-container nav-inner">
    <a class="brand" href="/" aria-label="Matt home" data-skip-home-flash
      >Matt<span>.</span></a
    >
    <nav aria-label="Primary navigation">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
            rel={link.rel}
            target={link.target}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-nav {
    backdrop-filter: blur(18px);
    background: color-mix(in srgb, var(--color-neutral) 92%, transparent);
    border-block-end: 1px solid var(--color-surface-muted);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .nav-inner {
    align-items: center;
    display: flex;
    gap: var(--spacing-200);
    justify-content: space-between;
    min-height: 72px;
  }

  .brand,
  nav a {
    align-items: center;
    color: var(--color-primary);
    display: inline-flex;
    min-height: 44px;
    text-decoration: none;
  }

  .brand {
    font-weight: 700;
  }

  .brand span {
    color: var(--color-accent);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-050) var(--spacing-150);
    justify-content: flex-end;
  }

  nav a {
    border-block-end: var(--spacing-025) solid transparent;
    font-size: 0.9375rem;
    padding-inline: var(--spacing-050);
  }

  nav a[aria-current="page"] {
    border-color: var(--color-accent);
  }

  @media (max-width: 28rem) {
    nav {
      column-gap: var(--spacing-075);
    }
  }
</style>
