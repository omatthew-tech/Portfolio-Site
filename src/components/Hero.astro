---
import { site } from "@/lib/site";
---

<section class="hero site-container" aria-labelledby="home-title">
  <div>
    <h1 id="home-title" class="display-xl">Hi, I'm Matt<span>.</span></h1>
    <p class="body-lg">
      I'm a product designer with previous experience in datacenter sales,
      fashion photography and computer science. I'm also a 4.0 pickleball
      player.
    </p>
    <div class="hero-actions" aria-label="Primary actions">
      <a class="button button-primary" href="#selected-work">Selected Work</a>
      <a class="button button-secondary" href={`mailto:${site.email}`}
        >Email Matt</a
      >
    </div>
  </div>
</section>

<style>
  .hero {
    align-items: end;
    display: grid;
    min-height: min(760px, calc(100svh - 84px));
    padding-block: clamp(4rem, 13vw, 8rem) var(--gap-hero);
  }

  .hero h1,
  .hero p {
    margin: 0;
  }

  .hero h1 span {
    color: var(--color-accent);
  }

  .hero .body-lg {
    color: var(--color-muted);
    margin-block-start: 1rem;
    max-width: 44rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 2rem;
  }
</style>
