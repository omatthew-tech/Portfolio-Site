---
import Figure from "@/components/Figure.astro";
---

<section class="hero site-container" aria-labelledby="home-title">
  <div class="hero-inner">
    <div class="hero-photo">
      <Figure
        src="/images/about/matt-with-camera-hero.webp"
        alt="Matt photographing outside with a camera."
        width={720}
        height={891}
        loading="eager"
        priority
        sizes="(min-width: 48rem) 13rem, 18rem"
      />
    </div>

    <div>
      <h1 id="home-title" class="display-xl">Hey, I'm Matt<span>.</span></h1>
      <p class="body-lg">
        I'm a creative problem solver with experience in datacenter sales,
        photography and computer science. I'm also a 4.0 pickleball player.
      </p>
      <div class="hero-actions" aria-label="Primary actions">
        <a class="button button-primary" href="#selected-work">Selected Work</a>
        <a class="button button-secondary" href="/about/">About</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    align-items: end;
    display: grid;
    min-height: min(760px, calc(100svh - 84px));
    padding-block: clamp(4rem, 13vw, 8rem) var(--gap-hero);
  }

  .hero-inner {
    align-items: center;
    display: grid;
    gap: var(--gap-section);
  }

  .hero-photo {
    width: min(100%, calc(var(--spacing-1600) * 2.25));
  }

  .hero-photo :global(.figure.figure-size-full img) {
    aspect-ratio: auto;
    border-radius: var(--radius-xl);
    height: auto;
    object-fit: contain;
    object-position: center;
  }

  .hero h1,
  .hero p {
    margin: 0;
  }

  .hero h1 span {
    color: var(--color-accent);
  }

  .hero .body-lg {
    color: var(--color-muted);
    margin-block-start: 1rem;
    max-width: 44rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 2rem;
  }

  @media (min-width: 48rem) {
    .hero-inner {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .hero-photo {
      width: calc(var(--spacing-1600) * 1.55);
    }
  }
</style>
