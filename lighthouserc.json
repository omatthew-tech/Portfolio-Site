{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-dist.mjs 4321",
      "startServerReadyPattern": "serving dist at http://127.0.0.1:4321",
      "url": [
        "http://127.0.0.1:4321/",
        "http://127.0.0.1:4321/work/test4test/"
      ],
      "settings": {
        "chromeFlags": "--headless=new --disable-gpu --no-sandbox --disable-dev-shm-usage --disable-crash-reporter --disable-features=Crashpad"
      },
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
